# Archivo de ejemplo: copia este archivo como ".env" y rellena tus valores reales.
# NUNCA subas el archivo .env al repositorio (está en .gitignore).

# Cadena de conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@TU_CLUSTER.mongodb.net/TU_BASEDEDATOS?retryWrites=true&w=majority

# Secreto para firmar los tokens de sesión (JWT)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Cuenta de administrador inicial (se crea sola al arrancar el servidor)
ADMIN_EMAIL=tu-admin@ejemplo.com
ADMIN_PASSWORD=contrasena-de-admin-segura

# Puerto del servidor (opcional; en Cloud Run lo inyecta la plataforma)
PORT=3000

# ============================================================
# HITO 4 - Servicios externos
# ============================================================

# Resend: envío del correo de confirmación de cuenta
# (https://resend.com -> API Keys). Sin clave, el enlace de
# confirmación se imprime en el registro del servidor (desarrollo/CI).
RESEND_API_KEY=re_tu_clave_de_resend

# Remitente del correo (opcional)
EMAIL_FROM=Dasna <onboarding@resend.dev>

# Google OAuth 2.0: inicio de sesión con Google
# (Google Cloud -> APIs & Services -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# URL pública de la app: construye el enlace de confirmación
# y la redirect URI de Google. En local: http://localhost:3000
URL_PUBLICA=http://localhost:3000
